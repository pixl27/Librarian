# What stays out of the public repository (github.com/pixl27/Librarian).

# Dependencies and build output
node_modules/
dist/
dist-tuning-fps/
tools/**/bin/
tools/**/obj/

# Local runs: test audits, server logs, agent state
audits/
run/
.unlazy/
*.log
__pycache__/

# Captured game traffic carries the account's session tokens
*.ndjson

# Leftovers of dependency updates (the installer build filters the same)
*.prev
*.tmp
deps/**/steamclient_experimental/steamclient_loader_*.exe

# Secrets never belong here
.env
.env.*
gh-token
