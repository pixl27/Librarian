{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Librarian dependencies",
      "type": "shell",
      "command": "npm",
      "args": [
        "install"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Librarian"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build Librarian portable EXE",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "dist"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Librarian"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run Librarian",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "start"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Librarian"
      },
      "problemMatcher": []
    }
  ]
}